{
  "expo": {
    "name": "persona",
    "slug": "persona",
    "version": "7.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "persona",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "translucent": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to use Face ID.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to improve your experience.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "bundleIdentifier": "com.romish.persona",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "155",
      "associatedDomains": [
        "applinks:personabest.com"
      ]
    },
    "android": {
      "versionCode": 5,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "personabest.com",
              "pathPrefix": "/user"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "persona"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.romish.persona",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
  "expo-localization",
  "expo-secure-store",
  [
    "expo-splash-screen",
    {
      "image": "./assets/images/splash.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }
  ],
  [
    "expo-build-properties",
    {
      "android": {
        "usesCleartextTraffic": true,
        "compileSdkVersion": 35,
        "targetSdkVersion": 35,
        "buildToolsVersion": "35.0.0",
        "enableJetifier": true,
        "extraMavenRepos": [],
        "ndkVersion": "27.0.12077973"
      },
      "ios": {
        "useFrameworks": "static"
      }
    }
  ],
  "@react-native-community/datetimepicker",
  "expo-asset",
  "expo-font",
  "expo-router",
  "./plugins/withAndroidManifestFix.js",
  "./plugins/withNdkVersion.js"
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0beb4cb8-bb22-4569-8076-991bd0685aac"
      }
    },
    "owner": "aluainko"
  }
}
